{
  "name": "tv-logout",
  "version": "0.1.0",
  "type": "module",
  "description": "Signs stray YouTube-on-TV sessions out of your Google Account, on a schedule, entirely on your own machine.",
  "keywords": [
    "youtube",
    "google-account",
    "sessions",
    "sign-out",
    "privacy",
    "macos",
    "automation",
    "playwright"
  ],
  "homepage": "https://github.com/moishemedia/tv-logout#readme",
  "bugs": {
    "url": "https://github.com/moishemedia/tv-logout/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/moishemedia/tv-logout.git"
  },
  "license": "MIT",
  "author": "MoisheMedia LLC",
  "scripts": {
    "setup": "node ./cli.mjs setup",
    "probe": "node ./cli.mjs probe",
    "evict": "node ./cli.mjs evict",
    "check": "node ./cli.mjs check",
    "weekly": "node ./cli.mjs weekly",
    "status": "node ./cli.mjs status",
    "schedule": "node ./cli.mjs schedule",
    "unschedule": "node ./cli.mjs unschedule",
    "watchdog": "node ./watchdog.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "playwright": "^1.63.0"
  }
}
